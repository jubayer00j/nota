<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="attachments/" />
        <!-- App Lock verifiers live in the preferences DataStore file
             (Phase 2a) — never backed up; see backup_rules.xml. No
             device-transfer section is declared, exactly as before, so
             D2D semantics for the notes database are unchanged. -->
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
</data-extraction-rules>
