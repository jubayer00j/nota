<?xml version="1.0" encoding="utf-8"?>
<!-- Nota's own backup/sync (Drive archive, spec §4) is the data-safety story;
     platform cloud backup is disabled for note databases by design. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <!-- Attachment binaries live under files/attachments (Phase 1c store);
         they travel in Nota's own backup ZIP, never in platform cloud backup. -->
    <exclude domain="file" path="attachments/" />
</full-backup-content>
