<?xml version="1.0" encoding="utf-8"?>
<!-- Nota's own backup/sync (Drive archive, spec §4) is the data-safety story;
     platform cloud backup is disabled for note databases by design. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <!-- Attachment binaries live under files/attachments (Phase 1c store);
         they travel in Nota's own backup ZIP, never in platform cloud backup. -->
    <exclude domain="file" path="attachments/" />
    <!-- The staged picker-insert record (Phase 3.6) is transient
         state — note id, caret offsets, an anchor DIGEST. Transient
         state never travels in a platform backup. -->
    <exclude domain="file" path="pending_insert.json" />
    <exclude domain="file" path="pending_insert.json.tmp" />
    <!-- Quick-capture staging (Phase 5.2): not-yet-delivered shared
         content + copied image bytes. Transient, and it may belong
         to whichever account was active when the share arrived —
         it must never travel into a platform backup. -->
    <exclude domain="file" path="pending_captures/" />
    <!-- The preferences DataStore file holds the App Lock PBKDF2 verifiers
         (Phase 2a): credential hashes must never leave the device in a
         platform backup, where low-entropy PIN/pattern verifiers could be
         attacked offline. Appearance prefs share the file and are also
         excluded — an accepted trade-off; they are trivially re-set. -->
    <exclude domain="file" path="datastore/" />
</full-backup-content>
