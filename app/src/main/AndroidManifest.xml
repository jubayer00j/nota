<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 3a: accounts (Firebase Auth), the account avatar, and
         (3b/3c) Google Drive. No other network use: notes never leave
         the device except inside the user's own Drive archive. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 2.5 (F4): biometric permissions, declared explicitly.
         USE_BIOMETRIC is the API 28+ permission; USE_FINGERPRINT is
         the API 23-27 one the framework FingerprintManager probe and
         the AndroidX FingerprintManagerCompat path require - without
         it, hasEnrolledFingerprints/isHardwareDetected fail on
         API 27. androidx.biometric merges its own copies, but Nota
         declares them itself so the merged manifest is auditable
         and cannot silently lose them in a library change. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27" />
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <!-- Phase 5.1 Reminders: notifications (runtime-granted on API
         33+, requested in context when a reminder is first set),
         exact alarms (API 31+; the app falls back to inexact
         scheduling and says so when not granted), and boot
         rescheduling. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 5.4: requested in context at first voice use only
         (never at app start); denial leaves every other flow alone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Phase 5.1: package visibility for the Clock-app hand-off —
         resolving ACTION_SET_ALARM on API 30+ needs the intent
         declared here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <!-- Phase 5.4: package visibility for the speech probe —
             SpeechRecognizer availability and the default service's
             enabled state are only readable with this on API 30+. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name="app.nota.NotaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nota">

        <!-- Phase 5.2: singleTask (1.x's choice) — quick-capture
             doors (shares, shortcuts, the QS tile, notification and
             pinned-note taps) must arrive as onNewIntent on the one
             running activity whose shell can stage them, never as a
             second stacked shell. -->
        <activity
            android:name="app.nota.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Phase 5.2 share target: other apps can share text
                 and images into Nota (mirrors 1.x). Extraction and
                 staging live in CaptureIntake, fed by MainActivity. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Phase 5.2 Quick Settings tile: capture from the QS panel
             (reachable from the lock screen on most devices). It
             stages a new-note capture; App Lock is never bypassed. -->
        <service
            android:name="app.nota.feature.capture.NotaCaptureTileService"
            android:label="@string/tile_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <!-- Phase 5.4: the "Voice note" QS tile — stages the voice
             door; the listening happens in the sheet, in-app. -->
        <service
            android:name=".feature.capture.NotaVoiceTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_voice_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Phase 5.1: alarm delivery (only Nota's own PendingIntents
             can reach it) and boot / clock-change rescheduling. -->
        <receiver
            android:name="app.nota.data.reminders.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="app.nota.data.reminders.ReminderRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Phase 5.3 Glance home-screen widget: not exported (the
             widget host reaches it through the system), no configure
             activity this phase. Renders the ACTIVE account's today
             glance under the WidgetStateMapper privacy rules — App
             Lock on means no note content, ever. -->
        <receiver
            android:name="app.nota.feature.widget.NotaWidgetProvider"
            android:exported="false"
            android:label="@string/widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nota_widget_info" />
        </receiver>
    </application>
</manifest>
